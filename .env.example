VITE_CONTENT_SOURCE=api
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=10000
# Cloudflare Turnstile public site key. Leave empty for the local test checkbox.
VITE_TURNSTILE_SITE_KEY=
# Enable only after FastAPI implements /settings/site and /users/me/preferences.
VITE_SETTINGS_API_ENABLED=false
# Backend-only settings. Configure these on the FastAPI server, not in the frontend build.
TURNSTILE_SECRET_KEY=
MAIL_API_URL=https://mail-api.twoword.cfd/api/v1/emails
