# 单文件交付物专用（`pnpm build:standalone` → vite build --mode standalone）
#
# nchu-cs-club-standalone.html 是给人双击打开 / 发群里的离线演示文件，
# 在 file:// 下不存在 /api，若沿用 .env 里的 api 源会满屏 CORS 报错，
# 所以这里固定走内置演示数据。
VITE_CONTENT_SOURCE=mock
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=10000
VITE_TURNSTILE_SITE_KEY=
VITE_SETTINGS_API_ENABLED=false
