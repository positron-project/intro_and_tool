# 单文件交付物专用（`pnpm build:standalone` → vite build --mode standalone）
#
# nchu-cs-club-standalone.html 是给人双击打开 / 发群里的离线演示文件，
# 在 file:// 下不存在 /api，若沿用 .env 里的 api 源会满屏 CORS 报错，
# 所以这里固定走内置演示数据。
VITE_CONTENT_SOURCE=mock
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=10000
VITE_TURNSTILE_SITE_KEY=
VITE_SETTINGS_API_ENABLED=false
# 博客区的 4 个变量必须在这里显式清空：Vite 在任何 mode 下都会先加载 `.env`，
# `.env.standalone` 只覆盖它自己声明的键。不写这四行，.env 里的隧道地址会被打进
# 单文件版（file:// 下必然请求失败），违背「单文件版固定走内置演示数据」的约定。
VITE_BLOG_API_BASE=
VITE_BLOG_SITE_URL=
VITE_BLOG_PAGE_SIZE=4
VITE_BLOG_TIMEOUT_MS=8000
